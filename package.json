{
  "name": "app-factory-mcp",
  "version": "0.2.0",
  "description": "App Factory - an orchestrator MCP server that guides any MCP-capable agent (Cursor, Devin, Claude...) from an app description to a deployed, audited application.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "app-factory-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "checklists",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DPGS-oss/app-factory-mcp.git"
  },
  "homepage": "https://github.com/DPGS-oss/app-factory-mcp#readme",
  "bugs": {
    "url": "https://github.com/DPGS-oss/app-factory-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cursor",
    "devin",
    "agent",
    "app-builder",
    "orchestrator",
    "audit",
    "design"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc --watch",
    "test": "node --test test/store.test.mjs test/catalog.test.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
